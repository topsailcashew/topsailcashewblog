# --- Database -------------------------------------------------------------
# Neon Postgres connection string (pooled endpoint is fine for the HTTP driver).
# Neon Console -> your project -> Connection Details -> "Connection string".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Admin auth -----------------------------------------------------------
# The password for the one and only author. Anything you can remember and that
# a stranger cannot guess.
ADMIN_PASSWORD="change-me"

# Signs the session cookie. Generate with:  openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET="change-me-to-32-plus-random-bytes"

# --- Media (Cloudflare R2) ------------------------------------------------
# No access keys needed: the bucket is reached through the MEDIA_BUCKET binding
# declared in wrangler.jsonc, and `next dev` backs it with a local bucket.
#
# Optional. Set this to serve uploads straight from a public r2.dev or custom
# domain instead of proxying them through the Worker at /media/<key>.
# R2_PUBLIC_BASE_URL="https://media.example.com"

# --- Local development only ----------------------------------------------
# Points the Neon HTTP driver at a local SQL-over-HTTP proxy (e.g. Neon Local)
# so `next dev` can run against a plain Postgres. Leave unset in production.
# NEON_FETCH_ENDPOINT="http://127.0.0.1:5599/sql"
